# Rename this file to ".env" and fill in real values. Never commit the real .env file.

# ---- Supabase ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ---- Groq LLM ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# ---- CORS (comma separated, e.g. your Vite dev server + deployed frontend) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- SLA thresholds in minutes, used for escalation checks ----
SLA_CRITICAL_MINUTES=10
SLA_HIGH_MINUTES=30
SLA_MEDIUM_MINUTES=60
SLA_LOW_MINUTES=120

# ---- Duplicate detection tuning ----
DUPLICATE_DISTANCE_KM=1.5
DUPLICATE_TIME_WINDOW_MINUTES=60
DUPLICATE_TEXT_SIMILARITY_THRESHOLD=70

# ---- Background scheduler ----
ESCALATION_CHECK_INTERVAL_SECONDS=60